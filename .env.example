# Gere um access token OAuth no painel de desenvolvedores do Mercado Livre.
# Nunca publique este valor no GitHub ou no frontend.
MELI_ACCESS_TOKEN=APP_USR-cole_seu_token_aqui

# Alternativa: o backend gera e renova o token automaticamente.
# Os nomes CLIENT_ID/CLIENT_SECRET também são aceitos.
MELI_CLIENT_ID=seu_client_id
MELI_CLIENT_SECRET=seu_client_secret
# Use a URL HTTPS cadastrada no aplicativo do Mercado Livre.
MELI_REDIRECT_URI=https://seu-dominio.com/api/auth/mercadolivre/callback
MELI_REFRESH_TOKEN=token_obtido_no_callback_oauth
OAUTH_STATE_SECRET=uma_chave_longa_e_aleatoria

# Também são aceitos: CLIENT_ID/CLIENT_SECRET ou ML_CLIENT_ID/ML_CLIENT_SECRET.
